@model RemittanceAdvice.ViewModels.Accounts.LoginViewModel

<h2>Enter to application</h2>

<form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label asp-for="Email"></label><br />
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password"></label><br />
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password"></span>
    </div>
    <br />
    <div class="form-group">
        <label asp-for="RememberMe"></label>
        <input asp-for="RememberMe"/>
    </div>
    <br />
    <div class="form-group">
        <input type="submit" value="Enter" class="btn btn-outline-secondary" />
    </div>
</form>