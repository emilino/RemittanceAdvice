@model RemittanceAdvice.ViewModels.Users.ChangePasswordViewModel
@{
    ViewBag.Title = "Change password";
}
<h2>Changing password for user @Model.Email</h2>
<form method="post" asp-action="ChangePassword" asp-controller="Users">
    <div asp-validation-summary="All"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />

    <div class="form-group">
        <label asp-for="NewPassword" class="control-label">New password</label>
        <input type="text" asp-for="NewPassword" class="form-control"/>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-sm btn-primary" />
    </div>
</form>